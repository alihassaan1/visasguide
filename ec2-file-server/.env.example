# File Server Configuration
PORT=3001
FILE_SERVER_SECRET=your-secure-secret-key-here

# Project root path (absolute path to visas.guide project)
PROJECT_ROOT=/var/www/visas.guide

# Backup configuration
BACKUP_DIR=/var/backups/visas-guide
MAX_BACKUPS=50

# Security
ALLOWED_ORIGINS=https://visas.guide,https://www.visas.guide,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/visas-guide-file-server/app.log
